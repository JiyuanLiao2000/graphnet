# USER SETUP REQUIRED
# The path macros below are validated smoke-test examples owned by the original
# deployer. Do not submit this file unchanged. Follow
# docs/madison_condor_quickstart.md and override every user-specific path.

universe = vanilla

executable = energy.sh

input_dir = /data/user/jliao/graphnet_unified_smoke_0414/output
output_dir = /data/user/jliao/graphnet_unified_smoke_0414/reconstruction_energy_condor
model_path = /data/user/jliao/software/graphnet_unified/models/energy/energy_model.pth
pulsemap = SplitRTCleanedInIcePulses
graphnet_root = /data/user/jliao/software/graphnet_unified
env_prefix = /data/user/jliao/envs/micromamba/envs/graphnet-reco
mamba = /data/user/jliao/software/micromamba/bin/micromamba
num_workers = 1
batch_size = 10
max_files = 1

arguments = $(input_dir) $(output_dir) $(model_path) $(pulsemap) $(graphnet_root) $(env_prefix) $(mamba) $(num_workers) $(batch_size) $(max_files)

request_cpus = $(num_workers)
request_memory = 8GB
request_gpus = 1

gpus_minimum_capability = 6.1
gpus_minimum_memory = 6GB

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = energy.sh

output = energy.$(ClusterId).$(ProcId).out
error = energy.$(ClusterId).$(ProcId).err
log = energy.$(ClusterId).log

queue
