universe = vanilla

executable = track_cascade.sh

input_dir = /data/user/jliao/graphnet_unified_smoke_0414/output
output_dir = /data/user/jliao/graphnet_unified_smoke_0414/reconstruction_track_cascade_condor
model_path = /data/user/jliao/software/graphnet_unified/models/track_cascade/track_cascade_model.pth
pulsemap = SplitRTCleanedInIcePulses
graphnet_root = /data/user/jliao/software/graphnet_unified
env_prefix = /data/user/jliao/envs/micromamba/envs/graphnet-reco
mamba = /data/user/jliao/software/micromamba/bin/micromamba
num_workers = 4

arguments = $(input_dir) $(output_dir) $(model_path) $(pulsemap) $(graphnet_root) $(env_prefix) $(mamba) $(num_workers)

