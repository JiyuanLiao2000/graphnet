# HTCondor submission settings.
executable = exe.sh

# Pulse map for this dataset
pulse_key = SplitRTCleanedInIcePulses
graphnet_root = /data/user/jliao/software/graphnet_unified

# Pass the GCD path, I3 path, output directory, pulse key, and GraphNeT checkout to exe.sh.
arguments = $(gcd_path) $(i3_path) /data/user/jliao/TANGO_check_2026/fifth_batch/ $(pulse_key) $(graphnet_root)

# Optional Singularity image.
#+SingularityImage="/data/user/jliao/software/icetray-v1.8.1-cuda11.8-cudnn8-graphnet-ubuntu22.04-2024-02-07"

# Each job processes one I3 file.
request_memory = 8GB
request_cpus = 1

transfer_executable = true
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

# Transfer conversion.py to the execution node.
transfer_input_files = conversion.py

# Write per-process logs to the conversion results directory.
# Include cluster and process identifiers to prevent filename collisions.
log = /scratch/jliao/conversion/results/job_$(Cluster)_$(Process).log
output = /scratch/jliao/conversion/results/job_$(Cluster)_$(Process).out
error = /scratch/jliao/conversion/results/job_$(Cluster)_$(Process).err


#Requirements = HAS_CVMFS_icecube_opensciencegrid_org && (OpSysMajorVer =?= 7) && GLIDEIN_Site =!= "Cedar"
Requirements = HAS_CVMFS_icecube_opensciencegrid_org && GLIDEIN_Site =!= "Cedar"
max_retries = 0
+osg_site_blacklist="Cedar"

# Read gcd_path and i3_path from the two-column manifest.
queue gcd_path, i3_path from test_list.txt
#queue gcd_path, i3_path from matched_file_list.txt
